# ==============================================================================
# Visibility Check Tracker - Environment Configuration
# ==============================================================================

# Ngrok Authtoken (Required for ngrok public tunneling)
# Get a free authtoken in 1 minute from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Tracker Login Credentials
AUTH_USERNAME=admin
AUTH_PASSWORD=tracker@2026
SECRET_KEY=visibility-tracker-secure-secret-2026

# Browser Automation (true in Docker; can be false on native Windows desktop)
BROWSER_HEADLESS=true

# Delay between sequential keyword checks (seconds)
DELAY_BETWEEN_KEYWORDS=2.0
